{
  "name": "@weekeasy/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.json",
    "format": "prisma format --config prisma.config.ts",
    "generate": "prisma generate --config prisma.config.ts",
    "lint": "eslint src --ignore-pattern src/generated/** --max-warnings=0",
    "migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "migrate:status": "prisma migrate status --config prisma.config.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.2.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@weekeasy/config": "workspace:*",
    "prisma": "7.10.0"
  }
}

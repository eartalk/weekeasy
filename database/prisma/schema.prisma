generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION

  @@map("user_status")
}

enum ProfileRelationship {
  SELF
  PARTNER
  FAMILY
  FRIEND
  OTHER

  @@map("profile_relationship")
}

enum ProfileGender {
  MALE
  FEMALE
  UNSPECIFIED

  @@map("profile_gender")
}

enum CalendarType {
  SOLAR
  LUNAR

  @@map("calendar_type")
}

enum BirthTimePrecision {
  MINUTE
  HOUR
  UNKNOWN_HOUR

  @@map("birth_time_precision")
}

enum DayBoundaryRule {
  MIDNIGHT
  LATE_ZI_HOUR

  @@map("day_boundary_rule")
}

enum ChartStatus {
  CALCULATED
  FAILED

  @@map("chart_status")
}

enum ActorType {
  USER
  ADMIN
  SYSTEM

  @@map("actor_type")
}

model User {
  id                  String     @id @default(uuid(7)) @db.Uuid
  email               String     @unique(map: "users_email_key")
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  status              UserStatus @default(ACTIVE)
  locale              String     @default("zh-CN")
  timezone            String     @default("Asia/Shanghai")
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)
  deletionRequestedAt DateTime?  @map("deletion_requested_at") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions            Session[]
  profiles            Profile[]
  auditLogs           AuditLog[]

  @@index([status, createdAt], map: "users_status_created_at_idx")
  @@map("users")
}

model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "sessions_token_hash_key") @map("token_hash")
  userAgent String?   @map("user_agent")
  ipHash    String?   @map("ip_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "sessions_user_id_expires_at_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model GuestSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  tokenHash  String    @unique(map: "guest_sessions_token_hash_key") @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  profiles   Profile[]

  @@index([expiresAt], map: "guest_sessions_expires_at_idx")
  @@map("guest_sessions")
}

model Profile {
  id                 String              @id @default(uuid(7)) @db.Uuid
  ownerUserId        String?             @map("owner_user_id") @db.Uuid
  anonymousId        String?             @map("anonymous_id") @db.Uuid
  displayName        String              @map("display_name")
  relationship       ProfileRelationship @default(SELF)
  gender             ProfileGender       @default(UNSPECIFIED)
  concernTopics      String[]            @default([]) @map("concern_topics")
  consentConfirmedAt DateTime?           @map("consent_confirmed_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(6)
  owner              User?               @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  guestSession       GuestSession?       @relation(fields: [anonymousId], references: [id], onDelete: Restrict)
  birthRecords       BirthRecord[]
  natalCharts        NatalChart[]

  @@index([ownerUserId, deletedAt], map: "profiles_owner_user_id_deleted_at_idx")
  @@index([anonymousId, deletedAt], map: "profiles_anonymous_id_deleted_at_idx")
  @@map("profiles")
}

model BirthRecord {
  id                    String             @id @default(uuid(7)) @db.Uuid
  profileId             String             @map("profile_id") @db.Uuid
  revision              Int
  calendarType          CalendarType       @map("calendar_type")
  isLeapMonth           Boolean            @default(false) @map("is_leap_month")
  precision             BirthTimePrecision
  localDate             String             @map("local_date")
  localTime             DateTime?          @map("local_time") @db.Time(0)
  timezoneId            String             @map("timezone_id")
  utcOffsetMinutes      Int                @map("utc_offset_minutes") @db.SmallInt
  countryCode           String?            @map("country_code") @db.Char(2)
  regionName            String?            @map("region_name")
  cityName              String?            @map("city_name")
  latitude              Decimal?           @db.Decimal(9, 6)
  longitude             Decimal?           @db.Decimal(9, 6)
  useTrueSolarTime      Boolean            @default(false) @map("use_true_solar_time")
  adjustedLocalDatetime DateTime?          @map("adjusted_local_datetime") @db.Timestamp(6)
  dayBoundaryRule       DayBoundaryRule    @default(MIDNIGHT) @map("day_boundary_rule")
  inputHash             String             @map("input_hash")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  supersededAt          DateTime?          @map("superseded_at") @db.Timestamptz(6)
  profile               Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  natalCharts           NatalChart[]

  @@unique([profileId, revision], map: "birth_records_profile_id_revision_key")
  @@index([profileId, createdAt(sort: Desc)], map: "birth_records_profile_id_created_at_idx")
  @@map("birth_records")
}

/// 排盘快照，记录创建后不可修改；引擎升级或规则配置变化时创建新记录。
model NatalChart {
  id                       String      @id @default(uuid(7)) @db.Uuid
  profileId                String      @map("profile_id") @db.Uuid
  birthRecordId            String      @map("birth_record_id") @db.Uuid
  engineVersion            String      @map("engine_version")
  calendarAdapter          String      @map("calendar_adapter")
  calendarAdapterVersion   String      @map("calendar_adapter_version")
  calculationPolicyVersion String      @map("calculation_policy_version")
  status                   ChartStatus @default(CALCULATED)
  yearPillar               String?     @map("year_pillar") @db.Char(2)
  monthPillar              String?     @map("month_pillar") @db.Char(2)
  dayPillar                String?     @map("day_pillar") @db.Char(2)
  hourPillar               String?     @map("hour_pillar") @db.Char(2)
  chartData                Json        @map("chart_data")
  warnings                 Json        @map("warnings")
  calculationHash          String      @map("calculation_hash")
  calculatedAt             DateTime    @default(now()) @map("calculated_at") @db.Timestamptz(6)
  profile                  Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  birthRecord              BirthRecord @relation(fields: [birthRecordId], references: [id], onDelete: Cascade)

  @@unique([calculationHash], map: "natal_charts_calculation_hash_key")
  @@index([profileId, calculatedAt(sort: Desc)], map: "natal_charts_profile_id_calculated_at_idx")
  @@index([birthRecordId, engineVersion], map: "natal_charts_birth_record_engine_idx")
  @@map("natal_charts")
}

model AuditLog {
  id           String    @id @default(uuid(7)) @db.Uuid
  actorUserId  String?   @map("actor_user_id") @db.Uuid
  actorType    ActorType @map("actor_type")
  action       String
  resourceType String    @map("resource_type")
  resourceId   String?   @map("resource_id") @db.Uuid
  metadata     Json      @default("{}")
  ipHash       String?   @map("ip_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  actor        User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt(sort: Desc)], map: "audit_logs_actor_user_id_created_at_idx")
  @@index([resourceType, resourceId, createdAt(sort: Desc)], map: "audit_logs_resource_created_at_idx")
  @@map("audit_logs")
}

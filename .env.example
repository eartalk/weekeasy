# Node.js 运行环境：本地开发使用 development，生产环境使用 production。
NODE_ENV=development

# Next.js Web 监听端口。当前 Next.js 默认使用 3000，后续可由启动脚本显式读取。
WEB_PORT=3000

# NestJS API 监听端口。
API_PORT=3001

# 浏览器端可见的 API 基础地址；这里绝对不能填写密钥或内部凭证。
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# PostgreSQL 参数；应用和 Prisma 会在服务端自动拼接连接串。
DB_HOST=150.158.3.213
DB_PORT=5432
DB_NAME=weekeasy
DB_SCHEMA=public
DB_USER=weekeasy
DB_PASSWORD=replace-with-database-password

# Redis 参数；默认用户通常为 default，远端 Redis 必须填写密码。
REDIS_HOST=150.158.3.213
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=replace-with-redis-password

# 本地 Mailpit 的 SMTP 主机与端口。
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025

# 系统发件人；生产环境必须换成邮件服务商已验证域名下的地址。
MAIL_FROM=noreply@weekeasy.local

# Session 签名密钥：至少 32 位随机字符串，生产环境必须独立生成并安全托管。
SESSION_SECRET=replace-with-at-least-32-random-characters

# 敏感输入 HMAC 密钥：必须与 SESSION_SECRET 不同，用于不可逆输入指纹。
DATA_HASH_SECRET=replace-with-a-different-random-secret

# OpenAI 服务端密钥；报告生成模块接入后填写，本地框架启动阶段可以留空。
OPENAI_API_KEY=

# Resend 服务端密钥；本地使用 Mailpit 时可以留空，线上发送邮件时填写。
RESEND_API_KEY=
